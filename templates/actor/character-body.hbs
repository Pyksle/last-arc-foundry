<div class="la-body">

  {{!-- ── Attributes · printed order Str·Vit·Agi·Int·Mnd·Chr ──────────────── --}}
  <section class="la-panel la-panel--attributes">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Attributes"}}</h2>
    <div class="la-attributes">
      {{#each attributes}}
        <div class="la-attribute">
          <button type="button" class="la-attribute__abbr" data-action="rollAttribute"
                  data-attribute="{{this.key}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.RollAttribute'}}">
            {{localize this.abbr}}
          </button>
          <input class="la-attribute__score" type="number"
                 name="system.attributes.{{this.key}}.value" value="{{this.valueInput}}" min="1">
          <div class="la-attribute__mod">{{lasignal this.mod}}</div>
          {{!-- Racial modifier and cap. Both are stored inputs that derivation
                READS (total = value + racialMod), and neither had a box, so a
                species' attribute line could not be recorded on the character
                it applied to. --}}
          <div class="la-attribute__race">
            <input type="number" name="system.attributes.{{this.key}}.racialMod"
                   value="{{this.racialMod}}"
                   data-tooltip="{{localize 'LASTARC.Tooltip.RacialMod'}}">
            <input type="number" name="system.attributes.{{this.key}}.cap"
                   value="{{this.cap}}" min="1"
                   data-tooltip="{{localize 'LASTARC.Tooltip.AttributeCap'}}">
          </div>
          <label class="la-attribute__label">{{localize this.label}}</label>
        </div>
      {{/each}}
    </div>
  </section>

  {{!-- ── Vitals ──────────────────────────────────────────────────────────── --}}
  <section class="la-panel la-panel--vitals">
    <div class="la-vital la-vital--hp">
      <h3>{{localize "LASTARC.Resource.HitPoints"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.resources.hp.value" value="{{system.resources.hp.value}}">
        <span class="la-sep">/</span>
        <span class="la-vital__max">{{system.resources.hp.max}}</span>
      </div>
      {{!-- The fill width comes from the sheet, not from CSS arithmetic: the
            percentage needs clamping and a divide-by-zero guard. --}}
      <div class="la-gauge" style="--fill: {{hpPercent}}%"><span></span></div>
      <label class="la-vital__sub">
        {{localize "LASTARC.Resource.Temp"}}
        <input type="number" name="system.resources.hp.temp" value="{{system.resources.hp.temp}}" min="0">
      </label>
    </div>

    <div class="la-vital la-vital--mp">
      <h3>{{localize "LASTARC.Resource.Mana"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.resources.mp.value" value="{{system.resources.mp.value}}">
        <span class="la-sep">/</span>
        <span class="la-vital__max">{{system.resources.mp.max}}</span>
      </div>
      <div class="la-gauge" style="--fill: {{mpPercent}}%"><span></span></div>
    </div>

    <div class="la-vital la-vital--hero">
      <h3>{{localize "LASTARC.Resource.HeroPoints"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.resources.heroPoints.value" value="{{system.resources.heroPoints.value}}" min="0">
        <span class="la-sep">/</span>
        <span class="la-vital__max">{{system.resources.heroPoints.max}}</span>
      </div>
      <div class="la-hero-spends">
        <button type="button" data-action="heroBoost" data-defence="ref"
                {{#unless canSpendHero}}disabled{{/unless}}
                data-tooltip="{{localize 'LASTARC.Tooltip.HeroBoost'}}">R</button>
        <button type="button" data-action="heroBoost" data-defence="fort"
                {{#unless canSpendHero}}disabled{{/unless}}
                data-tooltip="{{localize 'LASTARC.Tooltip.HeroBoost'}}">F</button>
        <button type="button" data-action="heroBoost" data-defence="will"
                {{#unless canSpendHero}}disabled{{/unless}}
                data-tooltip="{{localize 'LASTARC.Tooltip.HeroBoost'}}">W</button>
      </div>
      {{#if misfortuneBlocksReroll}}
        <span class="la-hero-blocked"
              data-tooltip="{{localize 'LASTARC.HeroPoint.MisfortuneBlocks'}}">
          {{localize "LASTARC.HeroPoint.NoReroll"}}
        </span>
      {{/if}}
    </div>

    <div class="la-vital la-vital--init">
      <h3>{{localize "LASTARC.Resource.Initiative"}}</h3>
      <div class="la-vital__single" data-tooltip="{{localize 'LASTARC.Tooltip.InitiativeInverted'}}">
        {{system.initiative.effectiveDie}}
      </div>
      <label class="la-vital__sub">{{localize "LASTARC.Resource.LowestFirst"}}</label>
      <label class="la-vital__sub"
             data-tooltip="{{localize 'LASTARC.Tooltip.InitiativeSteps'}}">
        {{localize "LASTARC.Field.InitSteps"}}
        <input type="number" name="system.initiative.bonusSteps"
               value="{{system.initiative.bonusSteps}}" min="0">
      </label>
    </div>

    <div class="la-vital la-vital--dr">
      <h3>{{localize "LASTARC.Resource.DamageReduction"}}</h3>
      <div class="la-vital__single">{{system.damageMods.dr}}</div>
    </div>

    <div class="la-vital la-vital--speed">
      <h3>{{localize "LASTARC.Resource.Speed"}}</h3>
      <div class="la-vital__single">{{system.movement.value}}</div>
      <label class="la-vital__sub">
        {{localize "LASTARC.Resource.Base"}}
        <input type="number" name="system.movement.base" value="{{system.movement.base}}" min="0">
      </label>
    </div>

    <div class="la-vital la-vital--secondwind">
      <h3>{{localize "LASTARC.Resource.SecondWind"}}</h3>
      <button type="button" class="la-button" data-action="secondWind"
              {{#unless system.resources.secondWind.canUse}}disabled{{/unless}}
              data-tooltip="{{localize 'LASTARC.Tooltip.SecondWind'}}">
        +{{system.resources.secondWind.healAmount}}
      </button>
      {{!-- One box per use, tickable BOTH ways (issue #10). The button above
            spends a use and heals; these are the record, and a table that has
            just rested clears them by hand. Nothing here resets on its own
            because nothing in the software knows a rest happened.

            A <button role="checkbox"> rather than an <input type="checkbox">:
            the sheet form submits on change, so a real checkbox would fire a
            form submission racing the action's own update. The Break Gauge
            track next door is buttons for the same reason. --}}
      <div class="la-secondwind" role="group"
           aria-label="{{localize 'LASTARC.Resource.SecondWindUses'}}">
        {{#each secondWindPips}}
          <button type="button" class="la-secondwind__pip"
                  role="checkbox" aria-checked="{{#if this.spent}}true{{else}}false{{/if}}"
                  data-action="setSecondWind" data-index="{{this.index}}"
                  aria-label="{{this.label}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.SecondWindPip'}}">
            {{#if this.spent}}✕{{/if}}
          </button>
        {{/each}}
      </div>
    </div>
  </section>

  {{!-- ── Movement modes ──────────────────────────────────────────────────── --}}
  {{!-- Fly, swim and climb had no inputs anywhere, so a winged character or
        anything underwater could not be represented at all. --}}
  <section class="la-panel la-panel--movement">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Movement"}}</h2>
    <div class="la-field-row">
      <div class="la-field la-field--narrow">
        <input type="number" name="system.movement.fly" value="{{movementInput.fly}}" min="0">
        <label>{{localize "LASTARC.Movement.fly"}}</label>
      </div>
      <div class="la-field la-field--narrow">
        <input type="number" name="system.movement.swim" value="{{system.movement.swim}}" min="0">
        <label>{{localize "LASTARC.Movement.swim"}}</label>
      </div>
      <div class="la-field la-field--narrow">
        <input type="number" name="system.movement.climb" value="{{system.movement.climb}}" min="0">
        <label>{{localize "LASTARC.Movement.climb"}}</label>
      </div>
      <label class="la-checkfield">
        <input type="checkbox" name="system.movement.hover" {{#if movementInput.hover}}checked{{/if}}>
        {{localize "LASTARC.Movement.hover"}}
      </label>
      <div class="la-field">
        <input type="text" name="system.movement.special" value="{{system.movement.special}}">
        <label>{{localize "LASTARC.Movement.special"}}</label>
      </div>
    </div>
  </section>

  {{!-- ── Proficiencies ───────────────────────────────────────────────────
        Both lists were read from the first release and had no input at all
        (issue #21): a weapon whose category is missing here costs −5 on every
        attack, and armour whose type is missing applies the armour check
        penalty to every Str- and Agi-based skill. So every character was
        non-proficient with everything, permanently, with no way to say
        otherwise.

        Toggle BUTTONS, not form checkboxes, and not a comma box. Both lists
        are closed sets, so typing `bludgeons` correctly to stop losing 5 from
        every attack would be a trap — but a bound checkbox is its own trap on
        this sheet: `submitOnChange` re-renders on every change, and a tick can
        be lost to the re-render between mousedown and click. Second Wind hit
        exactly this and was moved to buttons for exactly this reason (#28).

        Each button writes the array itself, so there is no form round-trip and
        no repacking step to get wrong.

        Shield proficiency moved here from the Movement panel, where it had
        been sitting next to the swim speed. --}}
  <section class="la-panel la-panel--proficiencies">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Proficiencies"}}</h2>
    <p class="la-note">{{localize "LASTARC.Note.ProficiencyPenalty"}}</p>

    <h3 class="la-prof__title">{{localize "LASTARC.Field.WeaponProficiency"}}</h3>
    <div class="la-prof">
      {{#each weaponProficiencies}}
        <button type="button" class="la-prof__box {{#if this.active}}is-active{{/if}}"
                role="checkbox" aria-checked="{{#if this.active}}true{{else}}false{{/if}}"
                data-action="toggleProficiency" data-prof="weapons" data-key="{{this.key}}">
          <span class="la-prof__tick">{{#if this.active}}✓{{else}}·{{/if}}</span>
          {{localize this.label}}
        </button>
      {{/each}}
    </div>

    <h3 class="la-prof__title">{{localize "LASTARC.Field.ArmourProficiency"}}</h3>
    <div class="la-prof">
      {{#each armourProficiencies}}
        <button type="button" class="la-prof__box {{#if this.active}}is-active{{/if}}"
                role="checkbox" aria-checked="{{#if this.active}}true{{else}}false{{/if}}"
                data-action="toggleProficiency" data-prof="armour" data-key="{{this.key}}">
          <span class="la-prof__tick">{{#if this.active}}✓{{else}}·{{/if}}</span>
          {{localize this.label}}
        </button>
      {{/each}}
      <button type="button"
              class="la-prof__box {{#if system.proficiencies.shields}}is-active{{/if}}"
              role="checkbox"
              aria-checked="{{#if system.proficiencies.shields}}true{{else}}false{{/if}}"
              data-action="toggleProficiency" data-prof="shields"
              data-tooltip="{{localize 'LASTARC.Tooltip.ShieldProficiency'}}">
        <span class="la-prof__tick">{{#if system.proficiencies.shields}}✓{{else}}·{{/if}}</span>
        {{localize "LASTARC.Field.ShieldProficiency"}}
      </button>
    </div>
  </section>

  {{!-- ── Defences · Threshold ────────────────────────────────────────────── --}}
  <section class="la-panel la-panel--defences">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Defences"}}</h2>
    <div class="la-defences">
      {{#each defenceRows}}
        <div class="la-defence">
          <span class="la-defence__label">{{localize this.label}}</span>
          <span class="la-defence__value"
                data-tooltip="{{localize 'LASTARC.Tooltip.BeforeBreak'}} {{this.beforeBreak}}">
            {{this.value}}
          </span>
          <div class="la-defence__parts">
            <span data-tooltip="{{localize 'LASTARC.Tooltip.ClassBonus'}}">{{lasignal this.classBonus}}</span>
            {{!-- Read-only. This was an <input>, but prepareDerivedData assigns
                  the technick total unconditionally, so a number typed here was
                  written to the database and then overwritten in memory on the
                  next prepare — it stored 7 and showed 0 back. Adjust it by
                  editing the technick that grants it, or use Misc. --}}
            <span class="la-defence__derived"
                  data-tooltip="{{localize 'LASTARC.Tooltip.Technicks'}}">
              {{lasignal this.technicks}}
            </span>
            <input type="number" name="system.defences.{{this.key}}.misc" value="{{this.miscInput}}"
                   data-tooltip="{{localize 'LASTARC.Tooltip.Misc'}}">
          </div>
        </div>
      {{/each}}

      <div class="la-defence la-defence--flatfooted">
        <span class="la-defence__label">{{localize "LASTARC.Defence.flatFooted"}}</span>
        <span class="la-defence__value">{{system.defences.ref.flatFooted}}</span>
      </div>

      <div class="la-defence la-defence--threshold"
           data-tooltip="{{localize 'LASTARC.Tooltip.Threshold'}}">
        <span class="la-defence__label">{{localize "LASTARC.Section.BreakThreshold"}}</span>
        <span class="la-defence__value la-defence__value--accent">{{system.breakGauge.threshold}}</span>
        <label class="la-defence__bonus">
          {{localize "LASTARC.Field.ThresholdBonus"}}
          <input type="number" name="system.breakGauge.thresholdBonus"
                 value="{{system.breakGauge.thresholdBonus}}"
                 data-tooltip="{{localize 'LASTARC.Tooltip.ThresholdBonus'}}">
        </label>
      </div>
    </div>
  </section>

  {{!-- ── Break Gauge · the signature mechanic ────────────────────────────── --}}
  <section class="la-panel la-panel--break">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.BreakGauge"}}</h2>

    <div class="la-break">
      {{#each breakTrack}}
        <button type="button"
                class="la-break__cell
                       {{#if this.isCurrent}}is-current{{/if}}
                       {{#if this.isPassed}}is-passed{{/if}}
                       {{#if this.isPersistent}}is-persistent{{/if}}
                       {{#if this.isTerminal}}is-terminal{{/if}}"
                data-action="setBreakStep" data-step="{{this.step}}"
                data-tooltip="{{localize 'LASTARC.Tooltip.SetBreakStep'}}">
          <span class="la-break__penalty">{{this.label}}</span>
          <span class="la-break__index">{{this.step}}</span>
        </button>
      {{/each}}
    </div>

    <p class="la-break__legend">{{localize "LASTARC.Break.AppliesTo"}}</p>

    <div class="la-break__recovery">
      <button type="button" class="la-button" data-action="bankRecovery"
              {{#if system.breakGauge.recoveryBlocked}}disabled{{/if}}
              data-tooltip="{{localize 'LASTARC.Tooltip.Recovery'}}">
        {{localize "LASTARC.Break.BankMinorAction"}}
      </button>
      <span class="la-break__progress">
        {{system.breakGauge.recoveryProgress}} / {{recoveryTarget}}
      </span>
      {{#if system.breakGauge.recoveryBlocked}}
        <span class="la-break__persistent">{{localize "LASTARC.Break.RecoveryBlocked"}}</span>
      {{/if}}
      {{#if system.breakGauge.persistentSteps}}
        <span class="la-break__persistent">
          {{localize "LASTARC.Break.PersistentFloor"}} {{system.breakGauge.persistentSteps}}
        </span>
      {{/if}}
    </div>

    {{!-- Each persistent step is a NAMED source with its own clearance
          requirement, and each must be cleared separately (§6). A bare count
          would make "which antidote do I still need?" unanswerable. --}}
    <div class="la-persistent">
      {{#each persistentSources}}
        <div class="la-persistent__row {{#if this.fromInjury}}is-injury{{/if}}">
          <span class="la-persistent__label">{{this.label}}</span>
          <span class="la-persistent__cleared">{{this.clearedBy}}</span>
          {{#if this.fromInjury}}
            <span class="la-persistent__tag"
                  data-tooltip="{{localize 'LASTARC.Tooltip.InjuryStep'}}">
              {{localize "LASTARC.Break.Injury"}}
            </span>
          {{/if}}
          <button type="button" class="la-persistent__clear" data-action="clearPersistent"
                  data-index="{{this.index}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ClearPersistent'}}">✓</button>
        </div>
      {{/each}}
      <button type="button" class="la-skill__add" data-action="addPersistent">
        + {{localize "LASTARC.Break.AddPersistent"}}
      </button>
    </div>

    {{#if system.resources.naturalHealingBlocked}}
      <p class="la-warning">{{localize "LASTARC.Warning.NaturalHealingBlocked"}}</p>
    {{/if}}
  </section>

  {{> laStatusPalette}}

  {{!-- ── Skills · five printed columns ───────────────────────────────────── --}}
  <section class="la-panel la-panel--skills">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Skills"}}</h2>
    {{!-- Stated once, here, rather than left as a secret gesture. A modifier
          key nobody is told about is a feature nobody can reach. --}}
    <p class="la-note">{{localize "LASTARC.Situational.Hint"}}</p>

    <div class="la-skills">
      <div class="la-skills__head">
        <span class="la-skills__col-name"></span>
        <span>{{localize "LASTARC.Column.Score"}}</span>
        <span>{{localize "LASTARC.Column.HalfLevel"}}</span>
        <span>{{localize "LASTARC.Column.Attrib"}}</span>
        <span>{{localize "LASTARC.Column.Trained"}}</span>
        <span>{{localize "LASTARC.Column.Focus"}}</span>
        <span>{{localize "LASTARC.Column.Bonus"}}</span>
        <span data-tooltip="{{localize 'LASTARC.Tooltip.AdjustmentColumn'}}">{{localize "LASTARC.Column.Adjustment"}}</span>
      </div>

      {{#each skills}}
        <div class="la-skill {{#if this.appliesArmourPenalty}}has-acp{{/if}}">
          <button type="button" class="la-skill__name" data-action="rollSkill" data-skill="{{this.key}}">
            {{localize this.label}}
            <span class="la-skill__attr">{{localize this.attrAbbr}}</span>
          </button>
          <span class="la-skill__total">{{lasignal this.total}}</span>
          <span class="la-skill__cell">{{this.halfLevel}}</span>
          <span class="la-skill__cell">{{lasignal this.attrMod}}</span>
          <input type="checkbox" name="system.skills.{{this.key}}.trained" {{#if this.trained}}checked{{/if}}>
          <input type="number" name="system.skills.{{this.key}}.focus" value="{{this.focus}}">
          <input type="number" name="system.skills.{{this.key}}.misc" value="{{this.miscInput}}">
          <span class="la-skill__cell la-skill__adjust {{#if this.hasAdjustment}}is-active{{/if}}"
                data-tooltip="{{this.adjustmentTooltip}}">{{lasignal this.adjustment}}</span>
        </div>

        {{#if this.subskilled}}
          {{#each this.subskills}}
            <div class="la-skill la-skill--sub">
              <button type="button" class="la-skill__name" data-action="rollSkill"
                      data-skill="{{../this.key}}" data-subskill="{{this.name}}">
                <input type="text" class="la-skill__subname"
                       name="system.skills.{{../this.key}}.subskills.{{this.index}}.name"
                       value="{{this.name}}">
              </button>
              <span class="la-skill__total">{{lasignal this.total}}</span>
              <span class="la-skill__cell"></span>
              <span class="la-skill__cell"></span>
              <input type="checkbox" name="system.skills.{{../this.key}}.subskills.{{this.index}}.trained" {{#if this.trained}}checked{{/if}}>
              <input type="number" name="system.skills.{{../this.key}}.subskills.{{this.index}}.focus" value="{{this.focus}}">
              <button type="button" class="la-skill__remove" data-action="removeSubskill"
                      data-skill="{{../this.key}}" data-index="{{this.index}}">×</button>
            </div>
          {{/each}}
          <button type="button" class="la-skill__add" data-action="addSubskill" data-skill="{{this.key}}">
            + {{localize "LASTARC.Skill.AddSpecialisation"}}
          </button>
        {{/if}}
      {{/each}}

      <div class="la-skill la-skill--passive">
        <span class="la-skill__name">{{localize "LASTARC.Skill.passivePerception"}}</span>
        <span class="la-skill__total">{{passivePerception}}</span>
        <span class="la-skill__formula">{{localize "LASTARC.Skill.PassiveFormula"}}</span>
      </div>
    </div>
  </section>

  {{!-- ── Action economy · only while in combat ───────────────────────────── --}}
  {{#if actionEconomy}}
    <section class="la-panel la-panel--actions">
      <h2 class="la-panel__title">{{localize "LASTARC.Section.Actions"}}</h2>

      <div class="la-slots">
        {{#each actionEconomy.slots}}
          <button type="button"
                  class="la-slot la-slot--{{this.key}} {{#unless this.available}}is-spent{{/unless}}"
                  data-action="toggleSlot" data-slot="{{this.key}}"
                  data-tooltip="{{localize this.tooltip}}">
            <span class="la-slot__name">{{localize this.label}}</span>
            <span class="la-slot__state">{{#if this.available}}●{{else}}○{{/if}}</span>
          </button>
        {{/each}}
      </div>

      <p class="la-slots__note">
        {{localize "LASTARC.Action.MinorsAvailable"}}
        <strong>{{actionEconomy.availableMinors}}</strong>
        <span class="la-slots__hint">{{localize "LASTARC.Action.DowngradeHint"}}</span>
      </p>

      {{!-- Banked minors for Aim and Recovery. Shown prominently because ANY
            intervening action — including a reaction on someone else's turn —
            resets it, and nobody tracks that by hand. --}}
      <div class="la-banked {{#if actionEconomy.banked.active}}is-active{{/if}}">
        {{#if actionEconomy.banked.active}}
          <span class="la-banked__label">{{localize actionEconomy.banked.label}}</span>
          <span class="la-banked__pips">
            {{#each actionEconomy.banked.pips}}
              <span class="la-banked__pip {{#if this}}is-filled{{/if}}"></span>
            {{/each}}
          </span>
          <span class="la-banked__count">
            {{actionEconomy.banked.count}} / {{actionEconomy.banked.required}}
          </span>
        {{else}}
          <span class="la-banked__idle">{{localize "LASTARC.Action.NothingBanked"}}</span>
        {{/if}}
      </div>

      <div class="la-reaction-state {{#if actionEconomy.reactionUsed}}is-used{{/if}}">
        {{#if actionEconomy.reactionsBlocked}}
          {{localize "LASTARC.Action.ReactionsBlocked"}}
        {{else if actionEconomy.reactionUsed}}
          {{localize "LASTARC.Action.ReactionUsed"}}
        {{else}}
          {{localize "LASTARC.Action.ReactionAvailable"}}
        {{/if}}
      </div>

      <div class="la-slots__buttons">
        <button type="button" class="la-button" data-action="bankAim">
          {{localize "LASTARC.Action.Aim"}}
        </button>
        <button type="button" class="la-button" data-action="holdTurn"
                data-tooltip="{{localize 'LASTARC.Tooltip.HoldTurn'}}">
          {{localize "LASTARC.Action.HoldTurn"}}
        </button>
        <button type="button" class="la-button" data-action="takeRest"
                data-tooltip="{{localize 'LASTARC.Tooltip.Rest'}}">
          {{localize "LASTARC.Action.Rest"}}
        </button>
        <button type="button" class="la-button" data-action="resetActions">
          {{localize "LASTARC.Action.Reset"}}
        </button>
      </div>
    </section>
  {{/if}}

  {{!-- ── Attacks ─────────────────────────────────────────────────────────── --}}
  <section class="la-panel la-panel--attacks">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Attacks"}}</h2>

    <div class="la-attacks">
      {{#each attacks}}
        <div class="la-attack {{#if this.unusable}}is-unusable{{/if}}">
          {{!-- Reordering is per PANEL, so the group travels with the button.
                A weapon appears here AND in Inventory and both arrows write the
                one `sort`, which is correct — an item has one place in the
                world. The arrows disable at the ends rather than wrapping. --}}
          {{> laItemOrder}}
          <img class="la-item__img" src="{{this.img}}" alt="">
          <button type="button" class="la-attack__name" data-action="rollAttack"
                  data-item-id="{{this.id}}"
                  {{#if this.unusable}}disabled{{/if}}>
            {{this.name}}
          </button>
          <span class="la-attack__wield" data-tooltip="{{localize this.wieldTooltip}}">
            {{localize this.wieldLabel}}
          </span>
          <span class="la-attack__bonus">{{lasignal this.atkTotal}}</span>
          <span class="la-attack__damage">
            {{this.damage}}{{#if this.damageFlat}} {{lasignal this.damageFlat}}{{/if}}
          </span>
          <span class="la-attack__type">
            {{~#each this.damageTypeLabels}}{{#unless @first}} / {{/unless}}{{localize this}}{{/each~}}
          </span>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoWeapons"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="createItem" data-group="attacks"
            data-tooltip="{{localize 'LASTARC.Tooltip.AddWeapon'}}">
      {{localize "LASTARC.Action.AddWeapon"}}
    </button>
  </section>

  {{!-- ── Technicks & talents ─────────────────────────────────────────────── --}}
  {{!-- Spells. The name is the cast button, matching the Attacks panel: in play
        you click the thing you just said out loud. --}}
  <section class="la-panel la-panel--spells">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Spells"}}</h2>

    <p class="la-note {{#if overSpellLimit}}is-warning{{/if}}">
      {{spells.length}} / {{knownSpellLimit}}
    </p>

    <div class="la-spells">
      {{#each spells}}
        <div class="la-spell {{#unless this.affordable}}is-unaffordable{{/unless}}"
             data-item-id="{{this.id}}">
          {{> laItemOrder}}
          <button type="button" class="la-spell__cast" data-action="castSpell"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.CastSpell'}}"
                  {{#unless this.affordable}}disabled{{/unless}}>
            <span class="la-spell__name">{{this.name}}</span>
            <span class="la-spell__cost">{{this.mpCost}}</span>
          </button>
          <span class="la-spell__school la-spell__school--{{this.school}}">{{this.schoolLabel}}</span>
          <span class="la-spell__time">{{this.castingTimeLabel}}</span>
          <button type="button" class="la-item__edit" data-action="editItem"
                  data-item-id="{{this.id}}">✎</button>
          <button type="button" class="la-item__share" data-action="shareItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ShareItem'}}">💬</button>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoSpells"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="createItem" data-group="spells"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddSpell"}}
    </button>
  </section>

  {{!-- Always rendered, never gated on performances.length. Hiding the panel
        when empty meant a bard had no way to add their FIRST performance —
        the one case where the panel matters most. --}}
  <section class="la-panel la-panel--performances">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Performances"}}</h2>
    <p class="la-note {{#if overPerformanceLimit}}is-warning{{/if}}">
      {{performances.length}} / {{knownPerformanceLimit}}
    </p>
    <div class="la-spells">
      {{#each performances}}
        <div class="la-spell {{#unless this.affordable}}is-unaffordable{{/unless}}">
          {{> laItemOrder}}
          <button type="button" class="la-spell__cast" data-action="performItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.Perform'}}">
            <span class="la-spell__name">{{this.name}}</span>
          </button>
          <span class="la-spell__time">{{this.specialisation}}</span>
          <button type="button" class="la-item__edit" data-action="editItem"
                  data-item-id="{{this.id}}">✎</button>
          <button type="button" class="la-item__share" data-action="shareItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ShareItem'}}">💬</button>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoPerformances"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="createItem" data-group="performances"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddPerformance"}}
    </button>
  </section>

  <section class="la-panel la-panel--technicks">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Technicks"}}</h2>

    <div class="la-items">
      {{#each technicks}}
        <div class="la-item {{#unless this.prereqsMet}}is-invalid{{/unless}}
                    {{#unless this.active}}is-suspended{{/unless}}">
          {{> laItemOrder}}
          <img class="la-item__img" src="{{this.img}}" alt="">
          {{!-- Only technicks with a mechanical flag get a switch: the rest
                have nothing to suspend, and a row of dead toggles is noise. --}}
          {{#if this.hasFlags}}
            <button type="button" class="la-item__switch" data-action="toggleTechnickActive"
                    role="switch" aria-checked="{{#if this.active}}true{{else}}false{{/if}}"
                    data-item-id="{{this.id}}"
                    data-tooltip="{{localize 'LASTARC.Tooltip.TechnickActive'}}"
            >{{#if this.active}}◉{{else}}○{{/if}}</button>
          {{/if}}
          <button type="button" class="la-item__name" data-action="editItem"
                  data-item-id="{{this.id}}">{{this.name}}</button>
          <span class="la-item__type">{{this.kindLabel}}</span>
          {{#if this.summary}}<span class="la-item__summary">{{this.summary}}</span>{{/if}}
          {{#unless this.prereqsMet}}
            <span class="la-item__warn"
                  data-tooltip="{{this.unmetText}}">{{localize "LASTARC.Item.PrereqsUnmet"}}</span>
          {{/unless}}
          <button type="button" class="la-item__share" data-action="shareItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ShareItem'}}">💬</button>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoTechnicks"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="createItem" data-group="technicks"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddTechnick"}}
    </button>
  </section>

  {{!-- ── Race & class features ───────────────────────────────────────────── --}}
  {{!-- Class LEVELS live in the header (system.classes) because the level maths
        depends on them. This panel is for the written features those choices
        grant, transcribed from your own book. --}}
  <section class="la-panel la-panel--features">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Features"}}</h2>

    <div class="la-items">
      {{#each features}}
        <div class="la-item">
          {{> laItemOrder}}
          <img class="la-item__img" src="{{this.img}}" alt="">
          <button type="button" class="la-item__name" data-action="editItem"
                  data-item-id="{{this.id}}">{{this.name}}</button>
          <span class="la-item__type">{{this.typeLabel}}</span>
          {{#if this.summary}}<span class="la-item__summary">{{this.summary}}</span>{{/if}}
          {{#if this.isLegacy}}
            <span class="la-item__warn"
                  data-tooltip="{{localize 'LASTARC.Tooltip.LegacyRaceItem'}}">{{localize "LASTARC.Item.Inert"}}</span>
          {{/if}}
          <button type="button" class="la-item__share" data-action="shareItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ShareItem'}}">💬</button>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoFeatures"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="createItem" data-group="features"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddFeature"}}
    </button>
  </section>

  {{!-- ── Inventory ───────────────────────────────────────────────────────── --}}
  <section class="la-panel la-panel--inventory">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Inventory"}}</h2>

    <div class="la-bulk {{#if bulkState}}is-{{bulkState}}{{/if}}">
      <span>{{localize "LASTARC.Field.Bulk"}}</span>
      <strong>{{system.bulk.value}}</strong>
      <span class="la-bulk__limits">
        / {{system.bulk.max}} {{localize "LASTARC.Bulk.encumberedAt"}}
        · {{system.bulk.overMax}} {{localize "LASTARC.Bulk.overencumberedAt"}}
      </span>
      {{#if bulkStateLabel}}
        <span class="la-bulk__state">{{localize bulkStateLabel}}</span>
      {{/if}}

      {{!-- Gold (issue #14). Beside Bulk because the two are the same
            question asked twice — what you are carrying and what you can
            afford — and a player pricing a purchase wants both at once. --}}
      <label class="la-bulk__gold">
        {{localize "LASTARC.Field.Gold"}}
        <input type="number" name="system.details.gold"
               value="{{system.details.gold}}" min="0">
      </label>
    </div>

    <div class="la-items">
      {{#each inventory}}
        <div class="la-item {{#if this.equipped}}is-equipped{{/if}}
                    {{#if this.broken}}is-broken{{/if}}">
          {{> laItemOrder}}
          <img class="la-item__img" src="{{this.img}}" alt="">
          <button type="button" class="la-item__name" data-action="editItem"
                  data-item-id="{{this.id}}">{{this.name}}</button>
          <span class="la-item__type">{{this.typeLabel}}</span>
          <span class="la-item__bulk">{{this.totalBulk}}</span>
          {{#if this.quantity}}<span class="la-item__qty">×{{this.quantity}}</span>{{/if}}
          {{#if this.equippable}}
            <button type="button" class="la-item__equip" data-action="toggleEquip"
                    data-item-id="{{this.id}}"
                    data-tooltip="{{localize 'LASTARC.Tooltip.ToggleEquip'}}">
              {{#if this.equipped}}●{{else}}○{{/if}}
            </button>
          {{/if}}
          <button type="button" class="la-item__share" data-action="shareItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ShareItem'}}">💬</button>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoItems"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="createItem" data-group="inventory"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddInventory"}}
    </button>
  </section>

  {{!-- ── Weapon skills · different rules from standard skills ────────────── --}}
  <section class="la-panel la-panel--weaponskills">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.WeaponSkills"}}</h2>
    <p class="la-note">{{localize "LASTARC.Note.WeaponSkills"}}</p>

    <div class="la-skills">
      {{#each weaponSkills}}
        <div class="la-skill {{#if this.appliesArmourPenalty}}has-acp{{/if}}">
          <button type="button" class="la-skill__name" data-action="rollSkill" data-skill="{{this.key}}">
            {{localize this.label}}
            <span class="la-skill__attr">{{localize this.attrAbbr}}</span>
          </button>
          <span class="la-skill__total">{{lasignal this.total}}</span>
          <span class="la-skill__cell">{{this.halfLevel}}</span>
          <span class="la-skill__cell">{{lasignal this.attrMod}}</span>
          <input type="checkbox" name="system.skills.{{this.key}}.trained" {{#if this.trained}}checked{{/if}}>
          <input type="number" name="system.skills.{{this.key}}.focus" value="{{this.focus}}">
          <input type="number" name="system.skills.{{this.key}}.misc" value="{{this.miscInput}}">
          <span class="la-skill__cell la-skill__adjust {{#if this.hasAdjustment}}is-active{{/if}}"
                data-tooltip="{{this.adjustmentTooltip}}">{{lasignal this.adjustment}}</span>
        </div>
      {{/each}}
    </div>
  </section>

  {{!-- ── Biography ───────────────────────────────────────────────────────
        HTMLField, so {{formInput}} gives a <prose-mirror> editor. There was
        no input for this anywhere. --}}
  <section class="la-panel la-panel--biography">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Biography"}}</h2>

    {{!-- Languages (issue #14). An ArrayField of plain strings, so one comma
          box rather than a row-adding widget — the same treatment a race
          item's languages get, and typing "Common, Elvish" is fewer clicks
          than any editor could be. --}}
    <div class="la-field">
      <input type="text" name="system.details.languagesText" value="{{languagesText}}"
             placeholder="{{localize 'LASTARC.Placeholder.Languages'}}">
      <label>{{localize "LASTARC.Field.Languages"}}</label>
    </div>

    {{formInput fields.details.fields.biography value=system.details.biography
                enriched=enrichedBiography toggled=true}}
  </section>

</div>
