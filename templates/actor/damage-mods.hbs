{{!--
  Weakness / resistance / immunity (#53).

  Shared by both actor sheets. The character sheet had none of these until the
  first Quench run pointed it out, while `applyDamage` had been reading them off
  characters all along — so the arithmetic honoured resistances nobody could
  enter. One partial rather than two copies, for the reason #44 exists.

  Comma-separated rather than a picker: there are a dozen damage types and a
  creature may be weak to several. Unknown entries are reported on submit
  instead of being dropped, so a typo does not read as the box refusing to save.
--}}
<section class="la-panel la-panel--damagemods" data-section="damagemods">
  {{> laSectionTitle id="damagemods"}}
  <div class="la-damagemods">
    <label class="la-damagemod">
      <span>{{localize "LASTARC.Field.Weakness"}}</span>
      <input type="text" name="system.damageMods.weakness" value="{{weaknessText}}"
             placeholder="{{localize 'LASTARC.Field.DamageTypeList'}}">
    </label>
    <label class="la-damagemod">
      <span>{{localize "LASTARC.Field.Resistance"}}</span>
      <input type="text" name="system.damageMods.resistance" value="{{resistanceText}}"
             placeholder="{{localize 'LASTARC.Field.DamageTypeList'}}">
    </label>
    <label class="la-damagemod">
      <span>{{localize "LASTARC.Field.Immunity"}}</span>
      <input type="text" name="system.damageMods.immunity" value="{{immunityText}}"
             placeholder="{{localize 'LASTARC.Field.DamageTypeList'}}">
    </label>
    {{!-- A character's DR is DERIVED from armour and grants, so it has no box
          of its own. This is the input slot beside it — the one an Active
          Effect writes, and the one a GM types a temporary reduction into
          (#88). A statblock's DR is printed and takes the effect directly, so
          it has no need of this. --}}
    {{#if hasDrMisc}}
      <label class="la-damagemod"
             data-tooltip="{{localize 'LASTARC.Tooltip.DrMisc'}}">
        <span>{{localize "LASTARC.Field.DrMisc"}}</span>
        <input type="number" name="system.damageMods.drMisc"
               value="{{system.damageMods.drMisc}}">
      </label>
    {{/if}}
  </div>
</section>
