{{!-- ── Status palette ────────────────────────────────────────────────────
      Shared by the character and NPC sheets.

      The statuses were registered in CONFIG.statusEffects from the first
      release and their payloads were wired into derivation, but the only way
      to put one ON anybody was the token HUD — so a character with no token
      on a scene could not be blinded, and nobody found the feature (issue
      #17). These are the same status ids; toggling here and toggling on the
      token do the same thing to the same actor.

      Curses are kept in their own row. Different curses stack and duplicates
      do not, which is a different rule from the statuses above them, and a
      single undifferentiated grid of 33 icons said nothing about that. --}}
<section class="la-panel la-panel--statuses">
  <h2 class="la-panel__title">{{localize "LASTARC.Section.Statuses"}}</h2>
  <p class="la-note">{{localize "LASTARC.Note.StatusesPersist"}}</p>

  {{!-- An unlinked token's actor is a different document (CLAUDE.md §7), and
        NPCs are unlinked by default. Opened from the Actors sidebar, this is
        the TEMPLATE — none of the statuses on any token show here, and
        toggling one changes nothing on the board. Reported as the palette
        being out of sync with the token (#47). --}}
  {{#if statusesAreTemplate}}
    <p class="la-warning la-warning--template">
      {{localize "LASTARC.Note.StatusesTemplateOnly"}}
    </p>
  {{/if}}

  <div class="la-statuses">
    {{#each statusPalette}}
      <button type="button"
              class="la-status {{#if this.active}}is-active{{/if}}"
              data-action="toggleStatus" data-status="{{this.id}}"
              aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"
              data-tooltip="{{this.label}}">
        {{!-- The badge itself, in an `src`, and not a url() anywhere (#51).

              It was a CSS mask, with the path handed to the stylesheet as
              `style="--la-status-icon: url('{{this.img}}')"`. Two things were
              wrong with that. A relative url() in a style ATTRIBUTE resolves
              against the document, which is what this path is written for — but
              carried through a custom property it resolves where the property
              is SUBSTITUTED, so Chromium prepended the stylesheet's own
              directory and every icon 404ed from
              systems/last-arc/styles/systems/last-arc/assets/…. And a mask
              keeps only the alpha channel, so even served it would have thrown
              away the family colours the badges were redrawn to carry (#43) and
              painted 33 identical discs.

              `alt` is empty and the element hidden because the name below is
              the accessible label; a second copy of it here would read the
              status out twice. --}}
        <img class="la-status__icon" src="{{this.img}}" alt="" aria-hidden="true">
        <span class="la-status__name">{{this.label}}</span>
        {{!-- A status applied more than once draws more than one token icon
              but is otherwise indistinguishable from one copy (#47). Clicking
              off removes them all. --}}
        {{#if this.count}}
          <span class="la-status__dupes"
                data-tooltip="{{localize 'LASTARC.Note.StatusDuplicates'}}"
                >&times;{{this.count}}</span>
        {{/if}}
      </button>
    {{/each}}
  </div>

  <h3 class="la-statuses__title">{{localize "LASTARC.Section.Curses"}}</h3>
  <div class="la-statuses">
    {{#each cursePalette}}
      <button type="button"
              class="la-status la-status--curse {{#if this.active}}is-active{{/if}}"
              data-action="toggleStatus" data-status="{{this.id}}"
              aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"
              data-tooltip="{{this.label}}">
        {{!-- The badge itself, not a mask and not a url() — see the note on the
              status row above (#51). --}}
        <img class="la-status__icon" src="{{this.img}}" alt="" aria-hidden="true">
        <span class="la-status__name">{{this.label}}</span>
        {{!-- A status applied more than once draws more than one token icon
              but is otherwise indistinguishable from one copy (#47). Clicking
              off removes them all. --}}
        {{#if this.count}}
          <span class="la-status__dupes"
                data-tooltip="{{localize 'LASTARC.Note.StatusDuplicates'}}"
                >&times;{{this.count}}</span>
        {{/if}}
      </button>
    {{/each}}
  </div>
</section>
