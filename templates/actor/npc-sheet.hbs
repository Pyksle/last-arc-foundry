{{!-- NPC sheet — shaped like a printed statblock rather than a character sheet.
      NPCs are authored numbers, not builds (§3.2), so nearly everything here is
      a direct input. The Break Gauge is the exception: printed defences are the
      UNBROKEN values and the gauge moves them. --}}
<div class="la-body la-body--npc">

  <header class="la-header la-header--npc">
    <div class="la-header__portrait">
      <img src="{{document.img}}" alt="{{document.name}}" data-edit="img"
           data-action="editImage"
           class="{{#unless canBrowseFiles}}is-locked{{/unless}}"
           data-tooltip="{{#if canBrowseFiles}}{{localize 'LASTARC.Tooltip.EditImage'}}{{else}}{{localize 'LASTARC.Tooltip.EditImageBlocked'}}{{/if}}">
    </div>
    <div class="la-header__fields">
      <div class="la-field la-field--name">
        <input type="text" name="name" value="{{document.name}}">
        <label>{{localize "LASTARC.Field.Name"}}</label>
      </div>
      <div class="la-field-row">
        <div class="la-field">
          <input type="text" name="system.details.type" value="{{system.details.type}}"
                 placeholder="{{localize 'LASTARC.Field.CreatureType'}}">
          <label>{{localize "LASTARC.Field.CreatureType"}}</label>
        </div>
        <div class="la-field">
          <select name="system.details.size">
            {{#each sizeOptions}}
              <option value="{{this.value}}" {{#if (laeq this.value ../system.details.size)}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
          <label>{{localize "LASTARC.Field.Size"}}</label>
        </div>
        <div class="la-field la-field--narrow">
          <input type="number" name="system.details.cr" value="{{system.details.cr}}" min="0">
          <label>{{localize "LASTARC.Field.CR"}}</label>
        </div>
        <div class="la-field la-field--narrow">
          <input type="number" name="system.details.xp" value="{{system.details.xp}}" min="0">
          <label>{{localize "LASTARC.Field.Experience"}}</label>
        </div>
      </div>
      <div class="la-field-row">
        <div class="la-field">
          <input type="text" name="system.details.temperament" value="{{system.details.temperament}}">
          <label>{{localize "LASTARC.Field.Temperament"}}</label>
        </div>
        <div class="la-field la-field--narrow">
          <input type="number" name="system.details.space" value="{{system.details.space}}" min="0">
          <label>{{localize "LASTARC.Field.Space"}}</label>
        </div>
        <div class="la-field la-field--narrow">
          <input type="number" name="system.details.reach" value="{{system.details.reach}}" min="0">
          <label>{{localize "LASTARC.Field.Reach"}}</label>
        </div>
      </div>
    </div>
  </header>

  <section class="la-panel la-panel--attributes">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Attributes"}}</h2>
    <div class="la-attributes">
      {{#each attributes}}
        <div class="la-attribute">
          <button type="button" class="la-attribute__abbr" data-action="rollAttribute"
                  data-attribute="{{this.key}}">{{localize this.abbr}}</button>
          <input class="la-attribute__score" type="number"
                 name="system.attributes.{{this.key}}.value" value="{{this.value}}" min="1">
          <div class="la-attribute__mod">{{lasignal this.mod}}</div>
        </div>
      {{/each}}
    </div>
  </section>

  <section class="la-panel la-panel--vitals">
    <div class="la-vital la-vital--hp">
      <h3>{{localize "LASTARC.Resource.HitPoints"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.resources.hp.value" value="{{system.resources.hp.value}}">
        <span class="la-sep">/</span>
        <input type="number" name="system.resources.hp.max" value="{{system.resources.hp.max}}">
      </div>
      {{!-- A GM tracking six monsters benefits from this more than a player
            tracking one character does. --}}
      <div class="la-gauge" style="--fill: {{hpPercent}}%"><span></span></div>
    </div>
    <div class="la-vital la-vital--mp">
      <h3>{{localize "LASTARC.Resource.Mana"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.resources.mp.value" value="{{system.resources.mp.value}}">
        <span class="la-sep">/</span>
        <input type="number" name="system.resources.mp.max" value="{{system.resources.mp.max}}">
      </div>
      <div class="la-gauge" style="--fill: {{mpPercent}}%"><span></span></div>
    </div>

    {{!-- Curses whose payload a statblock cannot apply to itself (#45). The
          maxima are printed inputs, not derived values, so derivation must not
          touch them — but an icon that lights up and moves no number reads as a
          bug, especially since the same curse on a player IS automatic. --}}
    {{#if manualAdjustments}}
      <div class="la-manual-note">
        <span class="la-manual-note__tag">{{localize "LASTARC.NpcManual.title"}}</span>
        <ul>
          {{#each manualAdjustments}}
            <li>{{localize this.hint}}</li>
          {{/each}}
        </ul>
        {{!-- The reason, once. It was on every line and read as boilerplate the
              second time, which is how a note stops being read at all. --}}
        <p class="la-manual-note__why">{{localize "LASTARC.NpcManual.why"}}</p>
      </div>
    {{/if}}
    <div class="la-vital">
      <h3>{{localize "LASTARC.Resource.Initiative"}}</h3>
      <div class="la-vital__single">{{system.initiative.effectiveDie}}</div>
      <label class="la-vital__sub">
        <input type="text" name="system.initiative.die" value="{{system.initiative.die}}">
      </label>
    </div>
    <div class="la-vital">
      <h3>{{localize "LASTARC.Resource.Speed"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.movement.base" value="{{system.movement.base}}" min="0">
      </div>
    </div>
    <div class="la-vital">
      <h3>{{localize "LASTARC.Resource.DamageReduction"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.damageMods.dr" value="{{system.damageMods.dr}}" min="0">
      </div>
    </div>
    <div class="la-vital">
      <h3>{{localize "LASTARC.Skill.passivePerception"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.passivePerception" value="{{system.passivePerception}}">
      </div>
    </div>
    <div class="la-vital">
      <h3>{{localize "LASTARC.Resource.TempHP"}}</h3>
      <div class="la-vital__pair">
        <input type="number" name="system.resources.hp.temp" value="{{system.resources.hp.temp}}" min="0">
      </div>
    </div>
  </section>

  {{!-- ── Ethos · senses · other movement ─────────────────────────────────── --}}
  {{!-- None of this had an input, so a statblock's alignment, its darkvision
        and anything that flies or swims were all unrecordable. --}}
  <section class="la-panel">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Bearing"}}</h2>
    <div class="la-field-row">
      <div class="la-field">
        <select name="system.details.ethosPurity">
          {{#each ethosPurityOptions}}
            <option value="{{this.value}}" {{#if (laeq this.value ../system.details.ethosPurity)}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
        <label>{{localize "LASTARC.Field.EthosPurity"}}</label>
      </div>
      <div class="la-field">
        <select name="system.details.ethosMorality">
          {{#each ethosMoralityOptions}}
            <option value="{{this.value}}" {{#if (laeq this.value ../system.details.ethosMorality)}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
        <label>{{localize "LASTARC.Field.EthosMorality"}}</label>
      </div>
      <div class="la-field">
        <input type="text" name="system.details.senses" value="{{system.details.senses}}"
               placeholder="{{localize 'LASTARC.Field.SensesPlaceholder'}}">
        <label>{{localize "LASTARC.Field.Senses"}}</label>
      </div>
    </div>
    <div class="la-field-row">
      <div class="la-field la-field--narrow">
        <input type="number" name="system.movement.fly" value="{{system.movement.fly}}" min="0">
        <label>{{localize "LASTARC.Movement.fly"}}</label>
      </div>
      <div class="la-field la-field--narrow">
        <input type="number" name="system.movement.swim" value="{{system.movement.swim}}" min="0">
        <label>{{localize "LASTARC.Movement.swim"}}</label>
      </div>
      <div class="la-field la-field--narrow">
        <input type="number" name="system.movement.climb" value="{{system.movement.climb}}" min="0">
        <label>{{localize "LASTARC.Movement.climb"}}</label>
      </div>
      <label class="la-checkfield">
        <input type="checkbox" name="system.movement.hover" {{#if system.movement.hover}}checked{{/if}}>
        {{localize "LASTARC.Movement.hover"}}
      </label>
      <div class="la-field">
        <input type="text" name="system.movement.special" value="{{system.movement.special}}">
        <label>{{localize "LASTARC.Movement.special"}}</label>
      </div>
      <div class="la-field la-field--narrow"
           data-tooltip="{{localize 'LASTARC.Tooltip.InitiativeSteps'}}">
        <input type="number" name="system.initiative.bonusSteps"
               value="{{system.initiative.bonusSteps}}" min="0">
        <label>{{localize "LASTARC.Field.InitSteps"}}</label>
      </div>
    </div>
  </section>

  {{!-- Printed (base) values on the left, live values after the gauge on the right. --}}
  <section class="la-panel la-panel--defences">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Defences"}}</h2>
    <p class="la-note">{{localize "LASTARC.Note.NpcDefences"}}</p>
    <div class="la-defences">
      {{#each defenceRows}}
        <div class="la-defence">
          <span class="la-defence__label">{{localize this.label}}</span>
          <span class="la-defence__value">{{this.value}}</span>
          <div class="la-defence__parts">
            <input type="number" name="system.defences.{{this.key}}.base" value="{{this.base}}"
                   data-tooltip="{{localize 'LASTARC.Tooltip.PrintedValue'}}">
          </div>
        </div>
      {{/each}}
      <div class="la-defence">
        <span class="la-defence__label">{{localize "LASTARC.Defence.flatFooted"}}</span>
        <span class="la-defence__value">{{system.defences.ref.flatFooted}}</span>
        <div class="la-defence__parts">
          <input type="number" name="system.defences.ref.flatFootedBase"
                 value="{{system.defences.ref.flatFootedBase}}"
                 placeholder="{{localize 'LASTARC.Field.Derived'}}"
                 data-tooltip="{{localize 'LASTARC.Tooltip.FlatFootedOverride'}}">
        </div>
      </div>
      <div class="la-defence la-defence--threshold">
        <span class="la-defence__label">{{localize "LASTARC.Section.BreakThreshold"}}</span>
        <span class="la-defence__value la-defence__value--accent">{{system.breakGauge.threshold}}</span>
        <div class="la-defence__parts">
          <input type="number" name="system.breakGauge.thresholdBase"
                 value="{{system.breakGauge.thresholdBase}}"
                 placeholder="{{localize 'LASTARC.Field.Derived'}}"
                 data-tooltip="{{localize 'LASTARC.Tooltip.ThresholdOverride'}}">
        </div>
      </div>
    </div>
  </section>

  <section class="la-panel la-panel--break">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.BreakGauge"}}</h2>
    <div class="la-break">
      {{#each breakTrack}}
        <button type="button"
                class="la-break__cell
                       {{#if this.isCurrent}}is-current{{/if}}
                       {{#if this.isPassed}}is-passed{{/if}}
                       {{#if this.isPersistent}}is-persistent{{/if}}
                       {{#if this.isTerminal}}is-terminal{{/if}}"
                data-action="setBreakStep" data-step="{{this.step}}">
          <span class="la-break__penalty">{{this.label}}</span>
          <span class="la-break__index">{{this.step}}</span>
        </button>
      {{/each}}
    </div>
    <p class="la-break__legend">{{localize "LASTARC.Break.AppliesTo"}}</p>
  </section>

  {{> laDamageMods}}

  {{> laStatusPalette}}

  {{> laEffectsPanel}}

  {{!-- Statblock attacks. The name is the roll button: a GM in combat is
        clicking the thing they just read aloud, not hunting for a d20 icon. --}}
  <section class="la-panel la-panel--attacks">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Attacks"}}</h2>

    <div class="la-attacks">
      {{#each attacks}}
        <div class="la-attack" data-index="{{this.index}}">

          <div class="la-attack__row la-attack__row--main">
            <button type="button" class="la-attack__roll" data-action="rollNpcAttack"
                    data-index="{{this.index}}"
                    data-tooltip="{{localize 'LASTARC.Tooltip.RollNpcAttack'}}">
              <span class="la-attack__name">{{this.displayName}}</span>
              <span class="la-attack__bonus">{{lasignal this.total}}</span>
            </button>

            {{#if this.brokenBy}}
              <span class="la-attack__broken"
                    data-tooltip="{{localize 'LASTARC.Tooltip.AttackBroken'}}">
                {{localize "LASTARC.Attack.Printed"}} {{lasignal this.printed}}
              </span>
            {{/if}}

            <span class="la-attack__damage">{{this.damageFormula}}</span>

            <button type="button" class="la-attack__delete" data-action="deleteAttack"
                    data-index="{{this.index}}"
                    data-tooltip="{{localize 'LASTARC.Tooltip.DeleteAttack'}}">×</button>
          </div>

          <div class="la-attack__row la-attack__row--edit">
            <label>
              <span>{{localize "LASTARC.Field.Name"}}</span>
              <input type="text" name="system.attacks.{{this.index}}.name" value="{{this.name}}">
            </label>
            <label>
              <span>{{localize "LASTARC.Field.AtkBonus"}}</span>
              <input type="number" name="system.attacks.{{this.index}}.atkBonus"
                     value="{{this.atkBonus}}"
                     data-tooltip="{{localize 'LASTARC.Tooltip.PrintedValue'}}">
            </label>
            <label>
              <span>{{localize "LASTARC.Field.DamageDice"}}</span>
              <input type="text" name="system.attacks.{{this.index}}.damage" value="{{this.damage}}">
            </label>
            <label>
              <span>{{localize "LASTARC.Field.DamageBonus"}}</span>
              <input type="number" name="system.attacks.{{this.index}}.damageBonus"
                     value="{{this.damageBonus}}">
            </label>
            <label>
              <span>{{localize "LASTARC.Field.DamageType"}}</span>
              <select name="system.attacks.{{this.index}}.damageType">
                {{#each ../damageTypeOptions}}
                  <option value="{{this.value}}"
                    {{#if (laeq this.value ../this.damageType)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </select>
            </label>
            <label>
              <span>{{localize "LASTARC.Field.OnHit"}}</span>
              <select name="system.attacks.{{this.index}}.appliesStatus">
                {{#each ../statusOptions}}
                  <option value="{{this.value}}"
                    {{#if (laeq this.value ../this.appliesStatus)}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </select>
            </label>
            <label class="la-attack__check">
              <input type="checkbox" name="system.attacks.{{this.index}}.isMelee"
                     {{#if this.isMelee}}checked{{/if}}>
              <span>{{localize "LASTARC.Field.Melee"}}</span>
            </label>
            <label class="la-attack__check">
              <input type="checkbox" name="system.attacks.{{this.index}}.isArea"
                     {{#if this.isArea}}checked{{/if}}
                     data-tooltip="{{localize 'LASTARC.Tooltip.AreaNoCrit'}}">
              <span>{{localize "LASTARC.Field.Area"}}</span>
            </label>
          </div>

          {{!-- Four fields that were declared on the schema with NO input and
                NO reader — dead at both ends. `count` is the one that matters
                at the table: a statblock's multiattack was unrecordable. --}}
          <div class="la-attack__row">
            <label>
              <span>{{localize "LASTARC.Field.AttackCount"}}</span>
              <input type="number" name="system.attacks.{{this.index}}.count"
                     value="{{this.count}}" min="1"
                     data-tooltip="{{localize 'LASTARC.Tooltip.AttackCount'}}">
            </label>
            {{#if this.isMelee}}
              <label>
                <span>{{localize "LASTARC.Field.Reach"}}</span>
                <input type="number" name="system.attacks.{{this.index}}.reach"
                       value="{{this.reach}}" min="0">
              </label>
            {{else}}
              <label>
                <span>{{localize "LASTARC.Field.Range"}}</span>
                <input type="text" name="system.attacks.{{this.index}}.range"
                       value="{{this.range}}"
                       data-tooltip="{{localize 'LASTARC.Tooltip.RangeText'}}">
              </label>
            {{/if}}
            <label class="la-attack__notes">
              <span>{{localize "LASTARC.Field.Notes"}}</span>
              <input type="text" name="system.attacks.{{this.index}}.notes"
                     value="{{this.notes}}">
            </label>
          </div>

          {{!-- Range increments, in squares (#43). Only on ranged attacks: a
                melee attack has reach, not bands, and four boxes asking about
                distance on a claw would be noise on every statblock.

                Leave them at zero and nothing changes — the roll does not stop
                to ask. Fill them in and this attack offers the same band picker
                a player gets, with the same -2/-5/-10. --}}
          {{#unless this.isMelee}}
            <div class="la-attack__row la-attack__row--edit la-attack__row--bands">
              <span class="la-attack__bandlabel"
                    data-tooltip="{{localize 'LASTARC.Tooltip.RangeBands'}}">
                {{localize "LASTARC.Field.RangeIncrements"}}
              </span>
              {{#each ../rangeBandFields}}
                <label class="la-attack__band">
                  <span>{{localize this.label}}</span>
                  <input type="number" min="0"
                         name="system.attacks.{{../this.index}}.rangeBands.{{this.key}}"
                         value="{{lookup ../this.rangeBands this.key}}"
                         data-tooltip="{{localize this.tooltip}}">
                </label>
              {{/each}}
            </div>
          {{/unless}}

        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoAttacks"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-button" data-action="addAttack">
      {{localize "LASTARC.Action.AddAttack"}}
    </button>
  </section>

  <section class="la-panel">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Items"}}</h2>
    <div class="la-items">
      {{#each items}}
        <div class="la-item" data-item-id="{{this.id}}">
          {{> laItemOrder}}
          <img class="la-item__img" src="{{this.img}}" alt="">
          <button type="button" class="la-item__name" data-action="editItem"
                  data-item-id="{{this.id}}">{{this.name}}</button>
          <span class="la-item__type">{{this.typeLabel}}</span>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoItems"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="createItem" data-group="npc"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddItem"}}
    </button>
  </section>

  {{!-- ── Loot & Steal ────────────────────────────────────────────────────
        Two tables of the same shape (§3.2): an item name and the percentage
        chance of getting it. Both were declared in the data model from the
        start with no input anywhere, so a GM could not record either. --}}
  <section class="la-panel la-panel--drops">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Spoils"}}</h2>
    <p class="la-note">{{localize "LASTARC.Note.SpoilsRecord"}}</p>

    <div class="la-drops">
      <div class="la-drops__table">
        <h3 class="la-drops__title">{{localize "LASTARC.Section.Loot"}}</h3>
        {{#each loot}}
          <div class="la-drop">
            <input type="text" name="system.loot.{{this.index}}.name" value="{{this.name}}"
                   placeholder="{{localize 'LASTARC.Field.DropItem'}}">
            <div class="la-drop__chance"
                 data-tooltip="{{localize 'LASTARC.Tooltip.DropChance'}}">
              <input type="number" name="system.loot.{{this.index}}.chance"
                     value="{{this.chance}}" min="0" max="100">
              <span class="la-drop__pct">%</span>
            </div>
            <button type="button" class="la-item__delete" data-action="deleteDrop"
                    data-drops="loot" data-index="{{this.index}}"
                    data-tooltip="{{localize 'LASTARC.Tooltip.DeleteDrop'}}">×</button>
          </div>
        {{else}}
          <p class="la-note">{{localize "LASTARC.Note.NoLoot"}}</p>
        {{/each}}

        <button type="button" class="la-panel__add" data-action="addDrop" data-drops="loot">
          {{localize "LASTARC.Action.AddLoot"}}
        </button>
      </div>

      <div class="la-drops__table">
        <h3 class="la-drops__title">{{localize "LASTARC.Section.Steal"}}</h3>
        {{#each steal}}
          <div class="la-drop">
            <input type="text" name="system.steal.{{this.index}}.name" value="{{this.name}}"
                   placeholder="{{localize 'LASTARC.Field.DropItem'}}">
            <div class="la-drop__chance"
                 data-tooltip="{{localize 'LASTARC.Tooltip.DropChance'}}">
              <input type="number" name="system.steal.{{this.index}}.chance"
                     value="{{this.chance}}" min="0" max="100">
              <span class="la-drop__pct">%</span>
            </div>
            <button type="button" class="la-item__delete" data-action="deleteDrop"
                    data-drops="steal" data-index="{{this.index}}"
                    data-tooltip="{{localize 'LASTARC.Tooltip.DeleteDrop'}}">×</button>
          </div>
        {{else}}
          <p class="la-note">{{localize "LASTARC.Note.NoSteal"}}</p>
        {{/each}}

        <button type="button" class="la-panel__add" data-action="addDrop" data-drops="steal">
          {{localize "LASTARC.Action.AddSteal"}}
        </button>
      </div>
    </div>
  </section>

  {{!-- ── Skills ──────────────────────────────────────────────────────────
        Printed totals, not derived rows. A statblock gives "Stealth +12" and
        that is the whole story — there was nowhere to record it at all. --}}
  <section class="la-panel la-panel--npcskills">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Skills"}}</h2>

    <div class="la-npc-skills">
      {{#each npcSkills}}
        <div class="la-npc-skill">
          <select name="system.skills.{{this.index}}.key">
            {{#each ../skillOptions}}
              <option value="{{this.value}}" {{#if (laeq this.value ../key)}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.skills.{{this.index}}.value" value="{{this.value}}">
          <button type="button" class="la-npc-skill__roll" data-action="rollNpcSkill"
                  data-index="{{this.index}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.RollNpcSkill'}}">🎲</button>
          <button type="button" class="la-item__delete" data-action="removeSkill"
                  data-index="{{this.index}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoNpcSkills"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="addSkill">
      {{localize "LASTARC.Action.AddSkill"}}
    </button>
  </section>

  {{!-- ── Technicks & talents ─────────────────────────────────────────────
        Split out of the generic item list, where a monster's abilities sat
        between its sword and its rations. --}}
  {{!-- Spells and Performances a statblock owns (#49).

        These fell into the generic Items list before: visible, but with no MP
        cost, no school and no way to cast them, so a magic-using monster had to
        be run entirely by hand.

        No spells-known budget here, unlike the character sheet. A statblock's
        list is authored, not built against a study limit (§3.2) — printing
        "3 / 2" against a monster would be inventing a rule for it. --}}
  <section class="la-panel la-panel--spells">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Spells"}}</h2>
    <div class="la-spells">
      {{#each spells}}
        <div class="la-spell {{#unless this.affordable}}is-unaffordable{{/unless}}"
             data-item-id="{{this.id}}">
          {{> laItemOrder}}
          <button type="button" class="la-spell__cast" data-action="castSpell"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.CastSpell'}}"
                  {{#unless this.affordable}}disabled{{/unless}}>
            <span class="la-spell__name">{{this.name}}</span>
            <span class="la-spell__cost">{{this.mpCost}}</span>
          </button>
          <span class="la-spell__school la-spell__school--{{this.school}}">{{this.schoolLabel}}</span>
          <span class="la-spell__time">{{this.castingTimeLabel}}</span>
          <button type="button" class="la-item__edit" data-action="editItem"
                  data-item-id="{{this.id}}">✎</button>
          <button type="button" class="la-item__share" data-action="shareItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ShareItem'}}">💬</button>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoSpells"}}</p>
      {{/each}}
    </div>
    <button type="button" class="la-panel__add" data-action="createItem" data-group="spells"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddSpell"}}
    </button>
  </section>

  <section class="la-panel la-panel--performances">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Performances"}}</h2>
    <div class="la-spells">
      {{#each performances}}
        <div class="la-spell {{#unless this.affordable}}is-unaffordable{{/unless}}"
             data-item-id="{{this.id}}">
          {{> laItemOrder}}
          <button type="button" class="la-spell__cast" data-action="performItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.Perform'}}"
                  {{#unless this.affordable}}disabled{{/unless}}>
            <span class="la-spell__name">{{this.name}}</span>
            <span class="la-spell__cost">{{this.mpCost}}</span>
          </button>
          <span class="la-spell__time">{{this.specialisation}}</span>
          <button type="button" class="la-item__edit" data-action="editItem"
                  data-item-id="{{this.id}}">✎</button>
          <button type="button" class="la-item__share" data-action="shareItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ShareItem'}}">💬</button>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoPerformances"}}</p>
      {{/each}}
    </div>
    <button type="button" class="la-panel__add" data-action="createItem" data-group="performances"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddPerformance"}}
    </button>
  </section>

  <section class="la-panel la-panel--technicks">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Technicks"}}</h2>

    <div class="la-items">
      {{#each technicks}}
        <div class="la-item">
          {{> laItemOrder}}
          <img class="la-item__img" src="{{this.img}}" alt="">
          <button type="button" class="la-item__name" data-action="editItem"
                  data-item-id="{{this.id}}">{{this.name}}</button>
          <span class="la-item__type">{{this.typeLabel}}</span>
          {{#if this.summary}}<span class="la-item__summary">{{this.summary}}</span>{{/if}}
          <button type="button" class="la-item__share" data-action="shareItem"
                  data-item-id="{{this.id}}"
                  data-tooltip="{{localize 'LASTARC.Tooltip.ShareItem'}}">💬</button>
          <button type="button" class="la-item__delete" data-action="deleteItem"
                  data-item-id="{{this.id}}">×</button>
        </div>
      {{else}}
        <p class="la-note">{{localize "LASTARC.Note.NoTechnicks"}}</p>
      {{/each}}
    </div>

    <button type="button" class="la-panel__add" data-action="createItem" data-group="technicks"
            data-tooltip="{{localize 'LASTARC.Tooltip.CreateItem'}}">
      {{localize "LASTARC.Action.AddTechnick"}}
    </button>
  </section>

  {{!-- ── Biography ───────────────────────────────────────────────────────
        HTMLField, so {{formInput}} gives a <prose-mirror> editor. There was
        no input for this anywhere. --}}
  <section class="la-panel la-panel--biography">
    <h2 class="la-panel__title">{{localize "LASTARC.Section.Biography"}}</h2>
    {{formInput fields.details.fields.biography value=system.details.biography
                enriched=enrichedBiography toggled=true}}
  </section>

</div>
