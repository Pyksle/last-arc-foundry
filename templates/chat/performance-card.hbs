{{!-- Performance result. Like the spell card there is no hit/miss — the Perform
      check selects a tier. Unlike it, there is no mana line: performances cost
      none (Chapter 9 never mentions MP).

      Every bonus and penalty states its SCOPE (issue #13). A tier that reads
      "+3" and nothing else is unreadable — Chapter 9's tiers are almost all
      "+N to <a named category>", and the category is the half that decides
      whether the number does anything at all. --}}
<div class="lastarc-card lastarc-card--performance">

  <header class="lastarc-card__head">
    <img src="{{img}}" alt="" class="lastarc-card__img">
    <div class="lastarc-card__title">
      <span class="lastarc-card__weapon">{{name}}</span>
      <span class="lastarc-card__sub">
        {{kindLabel}} · {{specLabel}}{{#if effectTagLabel}} · {{effectTagLabel}}{{/if}}
      </span>
    </div>
    <div class="lastarc-card__total" data-tooltip="{{breakdown}}">{{total}}</div>
  </header>

  <div class="lastarc-card__natural">
    <span class="lastarc-card__die">d20: <strong>{{natural}}</strong></span>
    {{#if parts.length}}
      <span class="lastarc-card__parts">
        {{#each parts}}
          <span class="lastarc-part" data-tooltip="{{localize this.label}}">
            {{lasignal this.value}}
          </span>
        {{/each}}
      </span>
    {{/if}}
  </div>

  {{#if achieved}}
    {{#if dc}}
      <p class="lastarc-verdict lastarc-verdict--good">
        {{localize "LASTARC.Card.Achieved" dc=dc}}
        <span class="lastarc-vs">{{total}} {{localize "LASTARC.Card.Versus"}} {{localize "LASTARC.Card.DC"}} {{dc}}</span>
      </p>
    {{/if}}

    {{#if opposed}}
      {{!-- The enfeebling gate: "should your check beat an enemy's Will
            Defence". An enhancing tier has no gate and never reaches here. --}}
      <p class="lastarc-verdict {{#if beat}}lastarc-verdict--good{{else}}lastarc-verdict--bad{{/if}}">
        {{#if targetName}}<strong>{{targetName}}</strong>{{/if}}
        {{#if beat}}
          {{localize "LASTARC.Card.PerformBeat"}}
        {{else}}
          {{localize "LASTARC.Card.PerformResisted"}}
        {{/if}}
        <span class="lastarc-vs">
          {{total}} {{localize "LASTARC.Card.Versus"}} {{defenceLabel}} {{defence}}
        </span>
      </p>
    {{/if}}

    {{#if landed}}
      {{!-- The scope goes INSIDE the sentence (issue #29). It used to be a chip
            appended to a sentence that already said "all weapon skills", so
            every other scope contradicted itself, and nothing said the bonus
            was to the d20 check rather than to damage. --}}
      {{#if skillBonus}}
        <p class="lastarc-rider lastarc-rider--heal">
          {{#if bonusScopeLabel}}
            {{localize "LASTARC.Card.PerformSkillBonus" n=skillBonus scope=bonusScopeLabel}}
          {{else}}
            {{localize "LASTARC.Card.PerformSkillBonusUnscoped" n=skillBonus}}
          {{/if}}
        </p>
      {{/if}}
      {{#if bonusDamage}}
        <p class="lastarc-rider lastarc-rider--combo">
          {{localize "LASTARC.Card.PerformBonusDamage" dice=bonusDamage}}
          {{#if bonusDamageScopeLabel}}<span class="lastarc-vs">{{bonusDamageScopeLabel}}</span>{{/if}}
        </p>
      {{/if}}
      {{#if penalty}}
        <p class="lastarc-rider lastarc-rider--crit">
          {{localize "LASTARC.Card.PerformPenalty" n=penalty}}
          {{#if penaltyScopeLabel}}<span class="lastarc-vs">{{penaltyScopeLabel}}</span>{{/if}}
        </p>
      {{/if}}

      {{#if damage}}
        <div class="lastarc-card__damage">
          <span class="lastarc-card__total" data-tooltip="{{damageBreakdown}}">{{damage.total}}</span>
          <span class="lastarc-card__type">{{localize "LASTARC.DamageType.unaspected"}}</span>
        </div>
        <p class="lastarc-calc"><span class="lastarc-calc__sum">{{damageBreakdown}}</span></p>

        {{!-- Held for a button rather than applied on resolution, matching the
              weapon and spell cards (issue #19). --}}
        <div class="lastarc-card__buttons">
          <button type="button" data-action="lastarcApplyDamage"
                  data-total="{{damage.total}}" data-damage-type="unaspected"
                  data-faces="{{damage.faces}}">
            {{localize "LASTARC.Card.ApplyToTargets"}}
          </button>
          <button type="button" data-action="lastarcApplyDamage" data-half="true"
                  data-total="{{damage.total}}" data-damage-type="unaspected"
                  data-faces="{{damage.faces}}">
            {{localize "LASTARC.Card.ApplyHalfToTargets"}}
          </button>
        </div>
      {{/if}}

      {{#if mpDamage}}
        {{!-- The mana die EXPLODES, which nothing else draining a resource
              does, so the total is worth stating beside the new value. --}}
        <p class="lastarc-rider lastarc-rider--crit">
          {{localize "LASTARC.Card.PerformMpLost" n=mpDamage.lost}}
          <span class="lastarc-vs">{{mpDamage.before}} → {{mpDamage.after}}</span>
        </p>
      {{/if}}

      {{#if statusLabel}}
        <p class="lastarc-rider lastarc-rider--status">
          {{localize "LASTARC.Card.OnHitApplies"}} <strong>{{statusLabel}}</strong>
        </p>
      {{/if}}
    {{/if}}

    {{#if effect}}<p class="lastarc-note">{{effect}}</p>{{/if}}
  {{else}}
    <p class="lastarc-verdict lastarc-verdict--neutral">
      {{localize "LASTARC.Card.NoEffect"}}
    </p>
  {{/if}}

  {{#if substitutesDefence}}
    <p class="lastarc-rider lastarc-rider--substitute">
      {{localize "LASTARC.Card.SubstitutesDefence" defence=substitutesDefence total=total}}
    </p>
  {{/if}}

  {{!-- Issue #20. A performance's riders used to be printed here and applied to
        nobody, so a bard buffing four allies meant four players remembering a
        number for the rest of the scene. The button puts it on whoever is
        targeted, as a real effect they can see on their own sheet. --}}
  {{#if canApplyEffect}}
    <div class="lastarc-card__buttons">
      <button type="button" data-action="lastarcApplyPerformance">
        {{localize "LASTARC.Card.ApplyPerformanceEffect"}}
      </button>
    </div>
  {{/if}}

  {{!-- Riders that cannot become a standing effect, with the reason. Printing
        them is the point: silently applying HALF of what the card promised is
        worse than saying which half could not be automated. --}}
  {{#each unappliableRiders}}
    <p class="lastarc-note lastarc-note--faint">
      <strong>{{this.label}}</strong> — {{this.reason}}
    </p>
  {{/each}}

  {{#if notes}}<p class="lastarc-note">{{notes}}</p>{{/if}}
  {{#if special}}<p class="lastarc-note">{{special}}</p>{{/if}}

  {{!-- The replacement rule is easy to forget at the table, so the card says it. --}}
  <p class="lastarc-note lastarc-note--faint">{{localize "LASTARC.Card.PerformanceReplaces"}}</p>

</div>
