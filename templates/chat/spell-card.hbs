{{!-- Spell result card. Deliberately shaped unlike the attack card: there is no
      hit/miss, because a Spellcraft check SELECTS AN OUTCOME rather than
      succeeding or failing. What the card has to answer is "which tier did I
      reach, and did the target resist it?" — and, since issue #11, "what does
      this spell actually do", which it previously left to the caster to look up
      mid-turn. --}}
<div class="lastarc-card lastarc-card--spell">

  <header class="lastarc-card__head">
    <img src="{{spellImg}}" alt="" class="lastarc-card__img">
    <div class="lastarc-card__title">
      <span class="lastarc-card__weapon">{{spellName}}</span>
      <span class="lastarc-card__sub">{{schoolLabel}} · {{localize "LASTARC.Card.SpellCast"}}</span>
    </div>
    <div class="lastarc-card__total" data-tooltip="{{breakdown}}">{{total}}</div>
  </header>

  <div class="lastarc-card__natural">
    <span class="lastarc-card__die">d20: <strong>{{natural}}</strong></span>
    <span class="lastarc-mana">{{localize "LASTARC.Card.ManaSpent" n=cost}}</span>
    {{#if parts.length}}
      <span class="lastarc-card__parts">
        {{#each parts}}
          <span class="lastarc-part" data-tooltip="{{localize this.label}}">
            {{lasignal this.value}}
          </span>
        {{/each}}
      </span>
    {{/if}}
  </div>

  {{#if arcanaLabel}}
    <p class="lastarc-rider lastarc-rider--arcana"
       data-tooltip="{{localize 'LASTARC.Tooltip.HighArcana'}}">{{arcanaLabel}}</p>
    {{#each arcanaNotes}}<p class="lastarc-note">{{this}}</p>{{/each}}
  {{/if}}

  {{#if achieved}}
    {{#if dc}}
      <p class="lastarc-verdict lastarc-verdict--good">
        {{localize "LASTARC.Card.Achieved" dc=dc}}
        <span class="lastarc-vs">{{total}} {{localize "LASTARC.Card.Versus"}} {{localize "LASTARC.Card.DC"}} {{dc}}</span>
      </p>
    {{/if}}

    {{#if opposed}}
      <p class="lastarc-verdict {{#if beat}}lastarc-verdict--good{{else}}lastarc-verdict--bad{{/if}}">
        {{#if targetName}}<strong>{{targetName}}</strong>{{/if}}
        {{#if beat}}
          {{localize "LASTARC.Card.SpellBeat" defence=defence}}
        {{else}}
          {{localize "LASTARC.Card.SpellResisted" defence=defence}}
        {{/if}}
        {{!-- Both numbers, named. "Resisted" alone was the reported complaint:
              a verdict with no arithmetic behind it. --}}
        <span class="lastarc-vs">
          {{total}} {{localize "LASTARC.Card.Versus"}} {{defenceLabel}} {{defence}}
          {{#if bonusApplied}}({{localize "LASTARC.Card.HigherLevelTarget" n=bonusApplied}}){{/if}}
        </span>
      </p>
    {{/if}}
  {{else}}
    <p class="lastarc-verdict lastarc-verdict--neutral">
      {{localize "LASTARC.Card.NoEffect"}}
    </p>
  {{/if}}

  {{#if damage}}
    <div class="lastarc-card__damage">
      <span class="lastarc-card__total" data-tooltip="{{damageBreakdown}}">{{damage.total}}</span>
      <span class="lastarc-card__type">{{damageTypeLabel}}</span>
    </div>
    {{#if damage.results.length}}
      <div class="lastarc-dice">
        {{#each damage.results}}
          <span class="lastarc-die {{#if this.exploded}}is-exploded{{/if}}
                       {{#if this.generation}}is-extra{{/if}}">{{this.result}}</span>
        {{/each}}
      </div>
    {{/if}}
    <p class="lastarc-calc"><span class="lastarc-calc__sum">{{damageBreakdown}}</span></p>
    {{#each decay}}
      <p class="lastarc-decay">{{localize "LASTARC.Card.DecayTick" amount=this.amount n=this.turnsAhead}}</p>
    {{/each}}

    {{!-- A spell used to land its damage the instant it resolved, while a
          weapon hit posted a button and waited. Half is its own button because
          a spell that deals half on a failed defence is routine (issue #19). --}}
    <div class="lastarc-card__buttons">
      <button type="button" data-action="lastarcApplyDamage"
              data-total="{{damage.total}}" data-damage-type="{{damage.damageType}}"
              data-faces="{{damage.faces}}">
        {{localize "LASTARC.Card.ApplyToTargets"}}
      </button>
      <button type="button" data-action="lastarcApplyDamage" data-half="true"
              data-total="{{damage.total}}" data-damage-type="{{damage.damageType}}"
              data-faces="{{damage.faces}}">
        {{localize "LASTARC.Card.ApplyHalfToTargets"}}
      </button>
    </div>
  {{/if}}

  {{#if healing}}
    {{!-- The heal posts its own card with the full sum; this is the pointer, so
          the cast and its effect are not two unrelated messages. A zombified
          target turns the heal into damage (§12), which must not be announced
          as healing. --}}
    <p class="lastarc-rider {{#if healing.inverted}}lastarc-rider--crit{{else}}lastarc-rider--heal{{/if}}">
      {{#if healing.inverted}}
        {{localize "LASTARC.Card.HealingInverted"}}
      {{else}}
        {{localize "LASTARC.Card.HealedFor" n=healing.applied}}
      {{/if}}
    </p>
  {{/if}}

  {{#if statusLabel}}
    <p class="lastarc-rider lastarc-rider--status">
      {{localize "LASTARC.Card.OnHitApplies"}} <strong>{{statusLabel}}</strong>
    </p>
  {{/if}}

  {{#if notes}}<p class="lastarc-note">{{notes}}</p>{{/if}}

  {{#if description}}
    <details class="lastarc-card__desc">
      <summary>{{localize "LASTARC.Card.WhatItDoes"}}</summary>
      <div class="lastarc-card__desc-body">{{{description}}}</div>
    </details>
  {{/if}}

</div>
