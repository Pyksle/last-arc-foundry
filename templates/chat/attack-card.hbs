{{!-- Attack result card. The Damage button stays available on an auto-hit, and
      the reaction notice is shown whenever the window is open — including on a
      natural 20, since Block and Dodge are opposed reactions rather than
      defence comparisons and are not bypassed by an auto-hit. --}}
<div class="lastarc-card lastarc-card--attack">

  <header class="lastarc-card__head">
    <img src="{{weaponImg}}" alt="" class="lastarc-card__img">
    <div class="lastarc-card__title">
      <span class="lastarc-card__weapon">{{weaponName}}</span>
      <span class="lastarc-card__sub">{{localize "LASTARC.Card.AttackRoll"}}</span>
    </div>
    <div class="lastarc-card__total {{#if outcome.autoHit}}is-auto-good{{/if}}
                {{#if outcome.autoMiss}}is-auto-bad{{/if}}"
         data-tooltip="{{breakdown}}">
      {{total}}
    </div>
  </header>

  <div class="lastarc-card__natural">
    <span class="lastarc-card__die">d20: <strong>{{natural}}</strong></span>
    {{!-- Misfortune rolled twice and kept the worse. Without this the card is
          indistinguishable from ordinary bad luck. --}}
    {{#if discardedNatural}}
      <span class="lastarc-misfortune"
            data-tooltip="{{localize 'LASTARC.Card.MisfortuneDiscarded'}}">
        <s>{{discardedNatural}}</s>
      </span>
    {{/if}}
    {{#if parts.length}}
      <span class="lastarc-card__parts">
        {{#each parts}}
          <span class="lastarc-part" data-tooltip="{{localize this.label}}">
            {{lasignal this.value}}
          </span>
        {{/each}}
      </span>
    {{/if}}
  </div>

  {{#if outcome.autoHit}}
    <p class="lastarc-verdict lastarc-verdict--good">
      {{localize "LASTARC.Card.AutoHit"}}
    </p>
  {{else if outcome.autoMiss}}
    <p class="lastarc-verdict lastarc-verdict--bad">
      {{localize "LASTARC.Card.AutoMiss"}}
    </p>
  {{else if hasTarget}}
    <p class="lastarc-verdict {{#if outcome.hit}}lastarc-verdict--good{{else}}lastarc-verdict--bad{{/if}}">
      {{#if outcome.hit}}{{localize "LASTARC.Card.Hit"}}{{else}}{{localize "LASTARC.Card.Miss"}}{{/if}}
      {{#if targetName}}<strong>{{targetName}}</strong>{{/if}}
      <span class="lastarc-vs">
        {{!-- `VsReflex` already reads "vs Reflex"; the Versus before it printed
             "vs vs Reflex" on every targeted attack card in the game. --}}
        {{total}} {{localize "LASTARC.Card.VsReflex"}} {{targetDefence}}
      </span>
    </p>
  {{else}}
    <p class="lastarc-verdict lastarc-verdict--neutral">
      {{localize "LASTARC.Card.NoTarget"}}
    </p>
  {{/if}}

  {{#if outcome.combo}}
    <p class="lastarc-rider lastarc-rider--combo">{{localize "LASTARC.Card.Combo"}}</p>
  {{/if}}
  {{#if outcome.critical}}
    <p class="lastarc-rider lastarc-rider--crit">{{localize "LASTARC.Card.Critical"}}</p>
  {{/if}}

  {{#if outcome.reactionWindowOpen}}
    <p class="lastarc-reaction">{{localize "LASTARC.Card.ReactionWindow"}}</p>
  {{/if}}

  {{#if statusLabel}}
    <p class="lastarc-rider lastarc-rider--status">
      {{localize "LASTARC.Card.OnHitApplies"}} <strong>{{statusLabel}}</strong>
    </p>
  {{/if}}

  {{!-- Statblock details. Multiattack is stated, not automated: each attack
        resolves against its own defence and can be blocked separately. --}}
  {{#if attackCount}}
    <p class="lastarc-rider">
      {{localize "LASTARC.Card.Multiattack"}} <strong>×{{attackCount}}</strong>
    </p>
  {{/if}}
  {{#if reachOrRange}}
    <p class="lastarc-note">{{localize reachLabel}} {{reachOrRange}}</p>
  {{/if}}
  {{#if attackNotes}}
    <p class="lastarc-note">{{attackNotes}}</p>
  {{/if}}

  {{!-- What the shot cost. Present only when the world tracks ammunition and
        the weapon spends it — every other card is unchanged.

        NOTE: the colours here are literal, like the rest of this card. Chat
        messages render OUTSIDE .last-arc so the palette variables never reach
        them, and a prefers-color-scheme rule on a .lastarc-* colour is
        forbidden outright (test/contrast). --}}
  {{#if ammo}}
    <p class="lastarc-note lastarc-ammo {{#if ammo.exhausted}}lastarc-ammo--out{{/if}}">
      {{localize "LASTARC.Ammo.Spent"}}
      <strong>{{ammo.name}} ×{{ammo.spent}}</strong>
      {{#if ammo.dieRoll}}
        · {{localize "LASTARC.Ammo.DieRoll"}} <strong>{{ammo.dieRoll}}</strong>
        {{#if ammo.shrank}}
          · {{localize ammo.dieBeforeLabel}} → <strong>{{localize ammo.dieAfterLabel}}</strong>
        {{else}}
          · {{localize ammo.dieAfterLabel}}
        {{/if}}
      {{else}}
        {{#if ammo.magazine}}
          · {{localize "LASTARC.Ammo.Loaded"}} <strong>{{ammo.loaded}}/{{ammo.capacity}}</strong>
        {{else}}
          · {{localize "LASTARC.Ammo.Left"}} <strong>{{ammo.remaining}}</strong>
        {{/if}}
      {{/if}}
    </p>
  {{/if}}

  {{#if outcome.hit}}
    {{!-- `hasAttackIndex` is a precomputed boolean, not an inline comparison:
          attack index 0 is legitimate and would test as falsy on its own. --}}
    <div class="lastarc-card__buttons">
      <button type="button" data-action="lastarcRollDamage"
              data-actor-id="{{actorId}}"
              {{#if weaponId}}data-weapon-id="{{weaponId}}"{{/if}}
              {{#if hasAttackIndex}}data-attack-index="{{attackIndex}}"{{/if}}
              data-critical="{{outcome.critical}}">
        {{localize "LASTARC.Card.RollDamage"}}
      </button>
      {{#if outcome.combo}}
        <button type="button" data-action="lastarcComboAttack"
                data-actor-id="{{actorId}}"
                {{#if weaponId}}data-weapon-id="{{weaponId}}"{{/if}}
                {{#if hasAttackIndex}}data-attack-index="{{attackIndex}}"{{/if}}>
          {{localize "LASTARC.Card.ComboAttack"}}
        </button>
      {{/if}}
    </div>
  {{/if}}

</div>
