{{!-- Damage card. Every exploded die is marked, because an exploding total that
      cannot be traced back to the dice reads as a bug to players. --}}
<div class="lastarc-card lastarc-card--damage">

  <header class="lastarc-card__head">
    <img src="{{weaponImg}}" alt="" class="lastarc-card__img">
    <div class="lastarc-card__title">
      <span class="lastarc-card__weapon">{{weaponName}}</span>
      <span class="lastarc-card__sub">
        {{localize "LASTARC.Card.Damage"}}
        <span class="lastarc-type">{{localize damageTypeLabel}}</span>
      </span>
    </div>
    <div class="lastarc-card__total" data-tooltip="{{breakdown}}">{{total}}</div>
  </header>

  {{#if critMultiplierLabel}}
    <p class="lastarc-rider lastarc-rider--crit">{{critMultiplierLabel}}</p>
  {{/if}}

  <div class="lastarc-dice">
    {{#each results}}
      <span class="lastarc-die {{#if this.exploded}}is-exploded{{/if}}
                   {{#if this.generation}}is-extra{{/if}}"
            data-tooltip="{{#if this.generation}}{{localize 'LASTARC.Card.ExplosionDie'}}{{else}}{{localize 'LASTARC.Card.WeaponDie'}}{{/if}}">
        {{this.result}}
      </span>
    {{/each}}
  </div>

  {{#if parts.length}}
    <div class="lastarc-card__natural">
      <span class="lastarc-card__parts">
        {{#each parts}}
          <span class="lastarc-part" data-tooltip="{{localize this.label}}">
            {{lasignal this.value}}
          </span>
        {{/each}}
      </span>
    </div>
  {{/if}}

  {{!-- The sum, in full. The dice above and the modifier chips beside them were
        both present, but nothing stated how they combined into the total —
        reported as "the damage calculation does not display" (issue #11). --}}
  <p class="lastarc-calc"><span class="lastarc-calc__sum">{{breakdown}}</span></p>

  {{#if capped}}
    <p class="lastarc-verdict lastarc-verdict--bad">{{localize "LASTARC.Card.DiceCapped"}}</p>
  {{/if}}

  {{!-- Half damage is its own button rather than a prompt: a spell that deals
        half on a failed defence is resolved constantly, and asking each time
        costs more than the second button does (issue #19). --}}
  <div class="lastarc-card__buttons">
    <button type="button" data-action="lastarcApplyDamage"
            data-total="{{total}}" data-damage-type="{{damageType}}" data-faces="{{faces}}">
      {{localize "LASTARC.Card.ApplyToTargets"}}
    </button>
    <button type="button" data-action="lastarcApplyDamage" data-half="true"
            data-total="{{total}}" data-damage-type="{{damageType}}" data-faces="{{faces}}">
      {{localize "LASTARC.Card.ApplyHalfToTargets"}}
    </button>
  </div>

</div>
