                 data-tooltip="{{localize 'LASTARC.Tooltip.GrantSkillTrained'}}">
            <input type="checkbox" name="system.grants.skills.{{this.index}}.trained"
                   {{#if this.trained}}checked{{/if}}>
            {{localize "LASTARC.Field.Trained"}}
          </label>
          <button type="button" class="la-item__delete" data-action="deleteSkillGrant"
                  data-index="{{this.index}}"
                  data-tooltip="{{localize 'LASTARC.Action.DeleteSkillGrant'}}">×</button>
        </div>
      {{/each}}

      <button type="button" class="la-panel__add" data-action="addSkillGrant">
        {{localize "LASTARC.Action.AddSkillGrant"}}
      </button>
