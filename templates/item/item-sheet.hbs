            <input type="number" name="system.grants.skills.{{this.index}}.focus"
                   value="{{this.focus}}">
            <label>{{localize "LASTARC.Field.Focus"}}</label>
          </div>
          <div class="la-field la-field--narrow"
               data-tooltip="{{localize 'LASTARC.Tooltip.GrantSkillBonus'}}">
            <input type="number" name="system.grants.skills.{{this.index}}.bonus"
                   value="{{this.bonus}}">
            <label>{{localize "LASTARC.Field.Bonus"}}</label>
          </div>
