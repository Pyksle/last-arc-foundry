      {{!-- Rerolls this trait grants (#48). The GM asked for "two checkboxes
            for mechanical effects inside of the technicks" — keep the new die,
            or keep the better one. Both semantics already existed and were read
            by nothing but the hero point.

            Generated from `LASTARC.grantableRerollKinds`, so a kind cannot be
            grantable in the schema and untickable here. `lower` is deliberately
            not grantable: it is the misfortune penalty, and an item handing it
            out would be giving a character a curse. --}}
      <div class="la-field-row la-field-row--rerolls">
        <span class="la-field-row__tag"
              data-tooltip="{{localize 'LASTARC.Tooltip.GrantsReroll'}}">
          {{localize "LASTARC.Field.GrantsReroll"}}
        </span>
        {{#each rerollKindFields}}
          <label class="la-check"
                 data-tooltip="{{localize this.tooltip}}">
            <input type="checkbox" name="system.grants.reroll.{{this.key}}"
                   {{#if this.checked}}checked{{/if}}>
            <span>{{localize this.label}}</span>
          </label>
        {{/each}}
        {{!-- Which skill the reroll applies to. The GM's examples each reroll
              one named skill, so blank ("any roll") is the exception. --}}
        <div class="la-field"
             data-tooltip="{{localize 'LASTARC.Tooltip.RerollSkill'}}">
          <select name="system.grants.reroll.skill">
            <option value="" {{#unless system.grants.reroll.skill}}selected{{/unless}}>
              {{localize "LASTARC.Field.RerollAnyRoll"}}
            </option>
            {{#each skillOptions}}
              <option value="{{this.value}}"
                {{#if (laeq this.value ../system.grants.reroll.skill)}}selected{{/if}}>
                {{localize this.label}}
              </option>
