            <div class="la-field la-field--narrow">
              <input type="number" name="system.outcomes.{{this.index}}.skillBonus"
                     value="{{this.skillBonus}}">
              <label>{{localize "LASTARC.Field.Bonus"}}</label>
            </div>
            <div class="la-field">
