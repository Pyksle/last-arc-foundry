              {{#each ../skillOptions}}
                <option value="{{this.value}}" {{#if (laeq this.value ../key)}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
            <label>{{localize "LASTARC.Field.Skill"}}</label>
